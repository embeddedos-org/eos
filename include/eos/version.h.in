/* Generated by CMake from include/eos/version.h.in into
   <build>/generated/eos/version.h. The version is the one in
   project(EoS VERSION ...) in the top-level CMakeLists.txt: C code that
   prints the EoS version should use EOS_VERSION, not a literal. */
#ifndef EOS_VERSION_H
#define EOS_VERSION_H

#define EOS_VERSION "@EoS_VERSION@"

#endif /* EOS_VERSION_H */
